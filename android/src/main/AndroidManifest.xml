<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Visibilidad de packages externos requerida en Android 11+ (API 30+):
        PackageManager.getLaunchIntentForPackage(...) sólo encuentra los packages
        declarados explícitamente aquí.

        Se mergea automáticamente al manifest de la app consumidora
        (DTEx / ParkingCash) en build time — no requiere cambios manuales.
    -->
    <queries>
        <package android:name="com.haulmer.paymentapp" />
        <package android:name="com.haulmer.paymentapp.dev" />
    </queries>

</manifest>
